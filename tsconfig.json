{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["vitest/globals"],

    // ENGINEERING_PRINCIPLES.md §6.1
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "exactOptionalPropertyTypes": true,

    // Absolute imports from src/ (mirrored in vite.config.mjs)
    "paths": {
      "assets/*": ["./src/assets/*"],
      "components/*": ["./src/components/*"],
      "hooks/*": ["./src/hooks/*"],
      "pages/*": ["./src/pages/*"],
      "schemas/*": ["./src/schemas/*"],
      "services/*": ["./src/services/*"],
      "store/*": ["./src/store/*"],
      "theme/*": ["./src/theme/*"],
      "types": ["./src/types"],
      "utils/*": ["./src/utils/*"]
    }
  },
  "include": ["src"]
}
