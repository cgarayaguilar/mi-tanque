    "@mui/material": "^9.4.0",
    "date-fns": "^2.17.0",
    "dexie": "^3.0.3",
    "react": "^19.3.0",
    "react-date-range": "^1.1.3",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-wavify": "^1.5.2",
    "sileo": "0.1.5",
    "wouter": "^2.7.3",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
